# PlasmaBENCH docker compose overrides — copy to docker/.env and edit.
# docker/.env is gitignored.
#
# Defaults (used when unset):
#   PLB_DATA=../data        # → /data inside the container
#   PLB_OUT=../simulations  # → /sim  inside the container
#
# Point at external storage if raw inputs / TimSim outputs live outside the repo:
#
# PLB_DATA=/mnt/big/plasmabench/raw
# PLB_OUT=/mnt/big/plasmabench/sim
