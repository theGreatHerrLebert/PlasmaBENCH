# Raw + intermediate data — never committed (link via fileshare/DVC instead).
/data/raw/**
!/data/raw/**/.gitkeep
# Top-level raw drop from Ute (reports, blanks, zips — multi-GB). Same policy.
/raw/
/data/**/*.d/
/simulations/**/seeds/
/simulations/**/dia/
/simulations/**/dda/
# Stage-2 superimpose output trees (dia-fix interim, dia-refmed native-knob): multi-GB
# .d + synthetic_data.db. Like stage-1 dia/, regenerate via render_configs.py + timsim.
/simulations/**/dia-*/
/simulations/**/*.d/
/simulations/**/*.log
/results/**
!/results/**/.gitkeep
!/simulations/**/results/.gitkeep

# DIA-NN spectral-library + lock scratch dropped at repo root
/lib.*
*.speclib
/plasmabench.lock
# Codex review scratch dumps
/plan.codex-review*.md

# Python
.venv/
__pycache__/
*.pyc
*.egg-info/

# Local env / tooling
docker/.env
.DS_Store
.ipynb_checkpoints/

# DIA-NN / external tool binaries (downloaded via scripts/get_diann.sh)
/tools/
