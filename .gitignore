# Raw + intermediate data — never committed (link via fileshare/DVC instead).
/data/raw/**
!/data/raw/**/.gitkeep
# Top-level raw drop from Ute (reports, blanks, zips — multi-GB). Same policy.
/raw/
/data/**/*.d/
/simulations/**/seeds/
/simulations/**/dia/
/simulations/**/dda/
/simulations/**/*.d/
/results/**
!/results/**/.gitkeep
!/simulations/**/results/.gitkeep

# Python
.venv/
__pycache__/
*.pyc
*.egg-info/

# Local env / tooling
docker/.env
.DS_Store
.ipynb_checkpoints/

# DIA-NN / external tool binaries (downloaded via scripts/get_diann.sh)
/tools/
